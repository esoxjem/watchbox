{
  "manifest_version": 3,
  "name": "Watchbox",
  "version": "0.3.0",
  "description": "A calmer YouTube: a finite subscriptions inbox, subtle save controls, and focused viewing in YouTube's own theme.",
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*"],
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["preferences.js", "page-settings.js", "page-start.js"],
    "css": ["content.css", "related.css"],
    "run_at": "document_start"
  }, {
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
    "js": ["core.js", "capture.js", "watch-later.js", "content.js"],
    "run_at": "document_idle"
  }],
  "action": {"default_title": "Watchbox settings", "default_icon": {"48": "icon.svg", "96": "icon.svg"}},
  "background": {"scripts": ["preferences.js", "background.js"]},
  "options_ui": {"page": "settings.html", "open_in_tab": true},
  "icons": {"48": "icon.svg", "96": "icon.svg"},
  "browser_specific_settings": {
    "gecko": {
      "id": "watchbox-prototype@local.watchbox",
      "strict_min_version": "142.0",
      "data_collection_permissions": {"required": ["authenticationInfo", "websiteContent", "websiteActivity"]}
    }
  }
}
