{
  "name": "watchbox-extension",
  "version": "0.3.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "lint": "web-ext lint",
    "build": "web-ext build",
    "amo": "node --env-file-if-exists=.env scripts/amo.mjs",
    "sign": "node --env-file-if-exists=.env node_modules/web-ext/bin/web-ext.js sign"
  },
  "webExt": {
    "sourceDir": ".",
    "artifactsDir": "artifacts",
    "ignoreFiles": ["tests", "artifacts", "scripts", "store", "docs", "package*.json", "AGENTS.md", "README.md", ".github"],
    "build": { "overwriteDest": true }
  },
  "devDependencies": {
    "jsdom": "^30.1.2",
    "web-ext": "^10.7.0"
  }
}
